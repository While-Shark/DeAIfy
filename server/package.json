    "fastify": "^5.6.0",
    "mysql2": "^3.15.0",
    "nodemailer": "^7.0.0",
    "sharp": "^0.34.5"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/nodemailer": "^7.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
