# Copy to .env.commercial, chmod 600, NEVER commit secrets.
FRONTEND_ORIGIN=https://deaify-iota.vercel.app
API_PUBLIC_ORIGIN=https://api.your-domain.example
API_BIND_PORT=18088
MYSQL_DATABASE=deaify
MYSQL_USER=deaify
MYSQL_PASSWORD=CHANGE_THIS_WITH_LONG_RANDOM_STRING
MYSQL_ROOT_PASSWORD=CHANGE_THIS_WITH_ANOTHER_LONG_RANDOM_STRING
# Generate: openssl rand -hex 32
RESULT_ENCRYPTION_KEY_HEX=REPLACE_WITH_64_HEX_CHARACTERS
# Generate: openssl rand -hex 32
PROCESSOR_SHARED_TOKEN=REPLACE_WITH_LONG_RANDOM_HEX_TOKEN
FREE_USES_PER_DAY=5
# Security gates: disabled by default
REGISTRATION_ENABLED=false
RECOVERY_ENABLED=false
PAYMENTS_ENABLED=false
MERCHANT_APPROVED=false
# Merchant account supplied only after signing with Xunhu; never in Vercel frontend!
XUNHU_APPID=
XUNHU_SECRET=
XUNHU_GATEWAY=https://api.xunhupay.com
# Registration must not be enabled before SMTP+Turnstile are configured.
TURNSTILE_SECRET=
OTP_SECRET=
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
