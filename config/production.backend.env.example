# VPS PRODUCTION TEMPLATE ONLY - contains placeholders, NOT functional secrets.
# Recommended: run bash scripts/setup.sh on VPS to generate .env.commercial.
# Keep the generated .env.commercial on the VPS, never in Git.
MYSQL_MODE=bundled
FRONTEND_ORIGIN=https://your-deaify-site.example.com
API_PUBLIC_ORIGIN=https://api.your-domain.example.com
API_BIND_PORT=18088

# Bundled MySQL 8.4. For existing MySQL use the setup wizard instead.
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_DATABASE=deaify
MYSQL_USER=deaify
MYSQL_PASSWORD=REPLACE_WITH_RANDOM_SECRET
MYSQL_ROOT_PASSWORD=REPLACE_WITH_ANOTHER_RANDOM_SECRET
MYSQL_SSL_MODE=disabled
MYSQL_SSL_CA_B64=

# Generate two independent 64-char hex secrets. Never reuse local secrets.
RESULT_ENCRYPTION_KEY_HEX=REPLACE_WITH_64_HEX
PROCESSOR_SHARED_TOKEN=REPLACE_WITH_LONG_RANDOM_SECRET
OTP_SECRET=REPLACE_WITH_LONG_RANDOM_SECRET

FREE_USES_PER_DAY=5
TRUSTED_PROXY_CIDRS=
REGISTRATION_ENABLED=false
RECOVERY_ENABLED=false

# Payments MUST remain disabled until merchant approval and callback tests.
PAYMENTS_ENABLED=false
MERCHANT_APPROVED=false
XUNHU_APPID=
XUNHU_SECRET=
XUNHU_GATEWAY=https://api.xunhupay.com

# Optional SMTP and Cloudflare Turnstile for verified registration.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
TURNSTILE_SECRET=
TURNSTILE_SITE_KEY=
